# Copy to .env.local for development. Real values go in Vercel → Settings → Environment Variables.
# NEVER commit real keys. Only NEXT_PUBLIC_* values are visible in the browser.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # "anon" / publishable key (public, protected by RLS)
SUPABASE_SERVICE_ROLE_KEY=               # "service_role" / secret key: SERVER ONLY, never NEXT_PUBLIC

# Public address of the site (used in emails and redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: email the owner on every new order + customers on status changes (resend.com)
RESEND_API_KEY=
EMAIL_FROM="Fresh Basket <orders@your-domain.in>"
OWNER_NOTIFICATION_EMAIL=

# Optional: privacy-friendly analytics (plausible.io), e.g. freshbasket.in
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
